# 影像缓存 & 输出（文件太大）
data/
output/

# 边界文件（示例 AOI 除外）
*.geojson
!examples/*.geojson

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Streamlit（主题配置随仓库发布，secrets 不入库）
.app_state.json

# 系统
.DS_Store
Thumbs.db
*.log
run_out*.log

# IDE
.vscode/
.idea/

# 运行时状态（.project_state.json 为当前版本；其余为旧版，首次启动时并入）
.project_state.json
.batch_state.json
.classify_state.json
.shared_state.json
.ts_state.json
.streamlit/*
!.streamlit/config.toml

# 开发截图
tmp/
DEV_CONTEXT.md
V3_UPGRADE_PLAN.md

# 本地 agent 配置（含本机路径，不入库）
.claude/
